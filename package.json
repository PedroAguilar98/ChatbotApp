{
  "name": "chatbot-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable floating chat widget, agnostic to the host app's framework, styling and auth.",
  "main": "./dist/chatbot-widget.umd.js",
  "module": "./dist/chatbot-widget.es.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/chatbot-widget.standalone.js",
  "jsdelivr": "./dist/chatbot-widget.standalone.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/chatbot-widget.es.js",
      "require": "./dist/chatbot-widget.umd.js"
    },
    "./standalone": "./dist/chatbot-widget.standalone.js",
    "./webcomponent": "./dist/chatbot-widget-element.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:webcomponent": "vite build --config vite.webcomponent.config.ts",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:dist": "npm run clean:dist && npm run build:types && npm run build:lib && npm run build:standalone && npm run build:webcomponent"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "axios": "^1.18.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.0"
  }
}
